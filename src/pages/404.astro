---
import Layout from '../layouts/BaseLayout.astro';
---

<Layout title="Page Not Found" description="This page doesn't exist.">
	<div class="notfound">
		<h1>404</h1>
		<p>This page doesn't exist.</p>
		<a href="/">← Back home</a>
	</div>
</Layout>

<style>
	.notfound {
		text-align: center;
		padding: 6rem 1rem;
	}
	.notfound h1 {
		font-size: 4rem;
		margin: 0 0 0.5rem 0;
	}
	.notfound p {
		color: rgb(var(--gray));
		margin: 0 0 2rem 0;
	}
	.notfound a {
		color: var(--accent);
		font-weight: 700;
		text-decoration: none;
	}
	.notfound a:hover {
		text-decoration: underline;
	}
</style>
