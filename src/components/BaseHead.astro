---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/headshot.jpg';
import { PERSON, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** website = default; article = blog post; profile = About page */
	type?: 'website' | 'article' | 'profile';
	publishedDate?: Date;
	updatedDate?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = FallbackImage,
	type = 'website',
	publishedDate,
	updatedDate,
} = Astro.props;

// Browser tab / search result title: "Page | Blake Maczka", or just the name on the homepage.
const documentTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;

const imageURL = new URL(image.src, Astro.url).href;
const homeURL = new URL('/', Astro.site).href;
const aboutURL = new URL('/about/', Astro.site).href;

// schema.org structured data (JSON-LD). Invisible on the page; read by search engines
// and AI crawlers. Every page describes the site and its owner; blog posts and the
// About page add a node for themselves that points back to the owner.
const personId = `${homeURL}#person`;
const person = {
	'@type': 'Person',
	'@id': personId,
	name: SITE_TITLE,
	url: homeURL,
	image: new URL(FallbackImage.src, Astro.site).href,
	jobTitle: PERSON.jobTitle,
	worksFor: { '@type': 'Organization', name: PERSON.employer.name, url: PERSON.employer.url },
	alumniOf: PERSON.alumniOf.map((name) => ({ '@type': 'CollegeOrUniversity', name })),
	homeLocation: { '@type': 'Place', name: PERSON.location },
	sameAs: Object.values(SOCIAL_LINKS),
};
const website = {
	'@type': 'WebSite',
	'@id': `${homeURL}#website`,
	url: homeURL,
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	author: { '@id': personId },
};
const pageNode =
	type === 'article'
		? {
				'@type': 'BlogPosting',
				'@id': `${canonicalURL.href}#article`,
				url: canonicalURL.href,
				mainEntityOfPage: canonicalURL.href,
				headline: title,
				description,
				image: imageURL,
				datePublished: publishedDate?.toISOString(),
				dateModified: (updatedDate ?? publishedDate)?.toISOString(),
				author: { '@id': personId },
				publisher: { '@id': personId },
				isPartOf: { '@id': `${homeURL}#website` },
			}
		: type === 'profile'
			? {
					'@type': 'ProfilePage',
					'@id': `${canonicalURL.href}#profile`,
					url: canonicalURL.href,
					name: title,
					mainEntity: { '@id': personId },
					isPartOf: { '@id': `${homeURL}#website` },
				}
			: null;
const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@graph': [website, person, pageNode].filter(Boolean),
}).replace(/</g, '\\u003c');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href="/fonts/atkinson-regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff2" as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{documentTitle}</title>
<meta name="title" content={documentTitle} />
<meta name="description" content={description} />
<meta name="author" content={SITE_TITLE} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{type === 'article' && publishedDate && (
	<meta property="article:published_time" content={publishedDate.toISOString()} />
)}
{type === 'article' && updatedDate && (
	<meta property="article:modified_time" content={updatedDate.toISOString()} />
)}
{type === 'article' && <meta property="article:author" content={aboutURL} />}

<!-- Structured data (schema.org) -->
<script type="application/ld+json" set:html={jsonLd} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
