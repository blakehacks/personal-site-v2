---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title = "Books", description = "Blake Maczka's personal website" } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}

			.toc {
				text-align: center;
				margin-bottom: 1.5em;
				font-size: 0.95em;
			}
			.toc a {
				margin: 0 0.5em;
				text-decoration: none;
			}
			.toc a:hover {
				text-decoration: underline;
			}

			.prose ul {
				padding-left: 1.25em;
				margin: 0 0 1em 0;
				display: block;
				list-style: disc;
			}
			.prose li {
				margin-bottom: 0.5em;
				font-size: 1.2em;
				text-align: left;
				width: 100%;
				line-height: 1.4;
			}

			.year {
				font-weight: 700;
				margin: 0.75em 0 0.25em;
			}

			html {
				scroll-behavior: smooth;
			}
		</style>
	</head>

